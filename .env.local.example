# 环境变量模板
#
# 本地开发：复制本文件为 .env.local，填入真实值。
#   cp .env.local.example .env.local
# .env.local 已在 .gitignore 中，不会被提交。
#
# 生产环境：微信云托管控制台 → 设置 → 环境变量，逐条添加。
# 不要把这些值写进任何会被提交的文件里。

# ============ 翻译模型（至少配一个） ============
#
# 通道按下面的顺序依次尝试，前一个失败才降级到下一个。

# 通道 1：智谱 GLM。glm-4.7-flash 当前是免费档（200K 上下文，限制单并发）。
# Key 申请：https://open.bigmodel.cn  → 控制台 → API Keys
ZHIPU_API_KEY=
# 可选。留空则用默认值 glm-4.7-flash。控制台免费型号代号变了就改这里。
ZHIPU_MODEL=

# 通道 2：DeepSeek。按量付费，价格很低；作为智谱失败后的降级。
# Key 申请：https://platform.deepseek.com  → API Keys
# 注意：新账号余额为 0，必须先充值，否则请求直接返回 402。
DEEPSEEK_API_KEY=
# 建议显式写 deepseek-flash。留空则用代码默认值（src/lib/translate.ts 的 PROVIDERS）。
# 旧默认值 deepseek-chat 已被官方下线 —— 型号代号以控制台「模型与价格」页为准。
DEEPSEEK_MODEL=

# ============ 独立全文审稿（默认启用） ============
# auto: 有NEWS_REVIEW_API_KEY时使用OpenAI，否则优先DeepSeek，再用已有智谱。
# 审稿是新的独立调用；未通过/超时/来源不足只进入待审，不会绕过审稿建草稿。
NEWS_REVIEW_PROVIDER=auto
# 可选OpenAI API密钥，单独计费，ChatGPT订阅不提供API额度。不要在聊天或Git中填写。
NEWS_REVIEW_API_KEY=
# OpenAI审稿型号；默认值以news-review-provider.ts为准。复用其他通道时用原通道型号变量。
NEWS_REVIEW_MODEL=
# 可选OpenAI联网核查，会增加费用。未启用时仅核对已存原文，不声称检索了外部来源。
NEWS_REVIEW_WEB_SEARCH=off

# ============ 数据库（Supabase） ============
# 推荐用通用命名；也兼容扣子注入的 COZE_SUPABASE_* 命名。
SUPABASE_URL=
SUPABASE_ANON_KEY=
# 可选，有则优先用于写入
SUPABASE_SERVICE_ROLE_KEY=

# ============ 成稿只读取回 ============
# 配置数据库地址和ANON Key后可用 pnpm drafts:pull --direct；不需要模型或微信凭据。
# 可选：通过腾讯服务取回归档时，服务端和读取端配置相同的独立只读Token。
NEWS_ARTIFACT_READ_TOKEN=
NEWS_SERVICE_BASE_URL=

# ============ 微信公众号 ============
# 留在微信云托管时，接口走「云调用」，**不需要**配置下面的 AppID/Secret；
# 代码里请求的是 http://api.weixin.qq.com，由平台侧完成鉴权。
# 如果哪天迁出微信云托管，才需要补上这两个并改造鉴权流程。
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# ============ Telegram 抓取（可选） ============
# 微信云托管在大陆，直连不了 t.me，必须经境外 Worker 代理。
# Worker 脚本见 docs/telegram-worker.js
TELEGRAM_WORKER_URL=
# 格式：国家:频道, 国家:频道  例：kz:@tengrinews, uz:@kunuzofficial
# 留空则使用代码内置的默认频道列表。
TELEGRAM_CHANNELS=

# ============ 「同一件事」模型判组（L2，默认关闭） ============
# 只有设成 on / 1 / true 才会启用。
# 默认关的原因：2026-09-21 实测，L2 在关闭 thinking 的免费通道上会把 18 条
# 毫无关系的新闻并成一组，采信就等于一次删掉 17 条不同新闻。
# 「误合并」丢信息且不可逆，所以默认必须是「不合并」。
# 先用 GET /api/dedupe-check?llm=1&judge=think|nothink&debug=1 看模型判得准不准，
# 确认后再打开这里。
SAME_EVENT_JUDGE=
