# 微信云托管配置
# 文档：https://developers.weixin.qq.com/miniprogram/dev/wxcloudrun/src/basic/guide.html
#
# ⚠️⚠️ 先读这段再改这个文件 ⚠️⚠️
# 走「从 Git 仓库部署」这条流水线时，**本文件里的平台参数不一定是生效值，控制台才是唯一事实来源**。
# 已经实测对不上的字段：
#   - container.port：文件 3000，控制台 5000 时按 5000 起探针 → Liveness probe failed 直接部署失败
#   - container.minNum：文件 0，控制台实际是 **最小 1**（实例常驻，所以下面那两条预热触发器其实用不上）
#   - container.cpu / mem：文件 0.5核1G，控制台实际 1核2G
# 要改端口/实例数/规格/触发器，**去控制台改**；改这个文件通常不会有效果。
# 流水线真正会读取并构建的只有 Dockerfile。
#
# 这个文件现在的价值是「记录意图」，不是「配置生效」。
# 保持它和控制台一致只是为了下次有人看代码时不至于被误导。

version: "1.0"
container:
  port: 3000
  minNum: 0
  maxNum: 5
  cpu: 0.5
  mem: 1
  policyType: cpu
  policyThreshold: 60
  envParams:
    SUPABASE_URL: ""
    SUPABASE_ANON_KEY: ""
    WECHAT_APP_ID: ""
    WECHAT_APP_SECRET: ""
  customLogs: "stdout"
  initialDelaySeconds: 5
  dataBaseName: "central_asia_news"
  executeSQLs:
    - "CREATE TABLE IF NOT EXISTS articles (id SERIAL PRIMARY KEY, title TEXT, summary TEXT, content TEXT, country_code VARCHAR(2), category VARCHAR(20), source_name VARCHAR(50), source_url TEXT, original_title TEXT, original_content TEXT, original_language VARCHAR(5), published_at TIMESTAMP WITH TIME ZONE, tags JSONB, is_featured BOOLEAN DEFAULT false, created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(), updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW());"

# 定时抓取与推送由应用内调度器负责：src/lib/scheduler.ts，每天 07:00 / 19:00 北京时间。
# 两段回看窗口首尾相接不重叠：早报 12h（昨日19:00→今日07:00）、晚报 12h（今日07:00→今日19:00）。
#
# 下面这两个触发器只做「预热」，不承担业务逻辑：实例被缩容到零时进程停了，
# 应用内定时器也就没了，提前 5 分钟唤醒它，才能在 07:00 / 19:00 准时触发。
#
# ⚠️ 预热时间必须跟着 `scheduler.ts` 里改后的时刻走 —— 改早报时刻时，这里也要改。
#
# 当前控制台的**最小实例数是 1**（实例常驻），所以这两条预热实际上用不上，
# 留着当保险（成本极低：每天两次唤醒请求）。真要靠预热时，得先在控制台确认它们已被创建 ——
# 写在文件里不等于在控制台生效。
#
# 注意：旧版这里挂着 4 条 08:00/12:30/15:00/21:00 的触发器，
# payload 是 {"action":"fetch-and-push"}——代码里根本没有处理这个 payload 的地方，
# 属于「看起来在定时抓取、实际什么都没干」，已清理。
triggers:
  - name: warmup-morning
    type: timer
    config: "50 22 * * *"  # 北京时间 06:55（UTC 前一日 22:50）
    payload: '{}'

  - name: warmup-evening
    type: timer
    config: "55 10 * * *"  # 北京时间 18:55（UTC 10:55）
    payload: '{}'
