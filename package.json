    "start": "bash ./scripts/start.sh",
    "ts-check": "tsc -p tsconfig.json",
    "validate": "pnpm dlx concurrently --group --names lint-tsc,lint-build,lint-style \"pnpm ts-check\" \"pnpm lint:build\" \"pnpm lint:style\"",
    "test:translate": "tsx scripts/test-translate.ts",
    "test:translate-providers": "tsx scripts/test-translate-providers.ts",
    "test:channels": "tsx scripts/test-telegram-channels.ts",
    "test:telegram-direct": "tsx scripts/test-telegram-direct.ts",
    "test:dedup": "tsx scripts/test-dedup.ts",
    "test:dedup-before-translate": "tsx scripts/test-dedup-before-translate.ts",
    "test:format": "tsx scripts/test-format.ts",
    "test:investment-score": "tsx scripts/test-investment-score.ts",
    "test:translate-prompt": "tsx scripts/test-translate-prompt.ts",
    "analyze:judge-stability": "tsx scripts/analyze-judge-stability.ts",
    "test:publish-window": "tsx scripts/test-publish-window.ts",
    "test:keepalive": "tsx scripts/test-keepalive.ts",
    "test:runtime-facts": "tsx scripts/test-runtime-facts.ts",
    "judge:ab": "tsx scripts/ab-judge-prompt.ts",
    "analyze:source-language": "tsx scripts/analyze-source-language.ts",
    "verify:local": "pnpm verify:offline && pnpm verify:online",
    "test:feed-fetch": "tsx scripts/test-feed-fetch.ts",
    "test:article-body": "tsx scripts/test-article-body.ts",
    "probe:article-body": "tsx scripts/probe-article-body.ts",
    "analyze:feeds": "tsx scripts/analyze-feeds.ts",
    "test:zh-gate": "tsx scripts/test-zh-gate.ts",
    "test:cyrillic-strip": "tsx scripts/test-cyrillic-strip.ts",
    "test:gate-wiring": "tsx scripts/test-gate-wiring.ts",
    "analyze:nouns": "tsx scripts/analyze-proper-nouns.ts",
    "analyze:title-gate": "tsx scripts/analyze-title-gate.ts",
    "analyze:last-round": "tsx scripts/analyze-last-round.ts",
    "analyze:cover-gaps": "tsx scripts/analyze-cover-gaps.ts",
    "analyze:mixed-script": "tsx scripts/analyze-mixed-script.ts",
    "analyze:cyrillic-note": "tsx scripts/analyze-cyrillic-note.ts",
    "analyze:currency": "tsx scripts/analyze-currency.ts",
    "analyze:country-filter": "tsx scripts/analyze-country-filter.ts",
    "analyze:pair-recall": "tsx scripts/analyze-pair-recall.ts",
    "analyze:judge-order": "tsx scripts/analyze-judge-order.ts",
    "analyze:recall-floor": "tsx scripts/analyze-recall-floor.ts",
    "analyze:guard-clusters": "tsx scripts/analyze-guard-clusters.ts",
    "analyze:object-veto": "tsx scripts/analyze-object-veto.ts",
    "analyze:judge-repro": "tsx scripts/analyze-judge-repro.ts",
    "analyze:per-country-floor": "tsx scripts/analyze-per-country-floor.ts",
    "probe:feeds": "tsx scripts/probe-feed-candidates.ts",
    "diagnose:push": "tsx scripts/diagnose-push-window.ts",
    "verify:offline": "pnpm ts-check && pnpm test:script-hygiene && pnpm test:judge-probe && pnpm test:channels && pnpm test:format && pnpm test:investment-score && pnpm test:translate-providers && pnpm test:translate-prompt && pnpm test:zh-gate && pnpm test:cyrillic-strip && pnpm test:feed-fetch && pnpm test:article-body && pnpm test:dedup && pnpm test:dedup-before-translate && pnpm test:editor-review && pnpm test:publish-window && pnpm test:proper-nouns && pnpm test:country-relevance && pnpm test:api-field-contract && pnpm test:keepalive && pnpm test:telegram-direct && pnpm test:gate-wiring && pnpm test:runtime-facts",
    "verify:online": "pnpm test:translate",
    "test:editor-review": "tsx scripts/test-editor-review.ts",
    "test:proper-nouns": "tsx scripts/test-proper-nouns.ts",
    "test:country-relevance": "tsx scripts/test-country-relevance.ts",
    "test:api-field-contract": "tsx scripts/test-api-field-contract.ts",
    "test:script-hygiene": "tsx scripts/test-script-hygiene.ts",
    "test:judge-probe": "tsx scripts/test-judge-probe.ts",
    "verify:knobs-live": "tsx scripts/verify-knobs-live.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.95.3",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "next": "16.1.1",
    "node-cron": "^4.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "rss-parser": "^3.13.0",
